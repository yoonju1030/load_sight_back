<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="loadsight.loadsightserver.mybatis.RunQueryMapper">

    <select id="getRunStatistics" resultType="loadsight.loadsightserver.dto.StatisticDto">
        SELECT
        e.success AS status,
        count(*) AS count
        FROM exec e
        WHERE run_id = #{runId}
        GROUP BY e.success
    </select>

</mapper>